# ---------------------------------------------------------------------------
# CRM Call Assistant backend — environment configuration
# Copy to `.env` (or export in your shell) and fill in real values.
# NO real secrets live in source control (NFR3).
# ---------------------------------------------------------------------------

# HTTP port the backend listens on.
BACKEND_PORT=8080

# Spring profile. Use "demo" for a zero-infra run (in-memory H2 + mock seed data).
# Leave as "default" to use the docker-compose Postgres.
SPRING_PROFILES_ACTIVE=default

# --- Database (default profile, Postgres from docker-compose) ---
DB_URL=jdbc:postgresql://localhost:5432/callassistant
DB_USERNAME=callassistant
DB_PASSWORD=change-me

# --- Recording server (FreeSWITCH/EC2) -------------------------------------
# The real FreeSWITCH box exposes exactly TWO HTTP endpoints under this base:
#   GET <base>/api/recordings/latest          -> most recent recording filename
#   GET <base>/api/recordings/download/:name  -> that .wav
# Behind nginx over HTTPS (see freeswitch/RECORDING-SETUP.md). There is ONE
# stereo .wav per call; the backend maps a call to the "latest" filename when
# the call ends. NO UUID resolution, NO dialplan key.
RECORDING_BASE_URL=https://your-ec2-host
# Optional API key sent as the X-API-Key header to the recordings server.
# Leave blank if the endpoints are unauthenticated in your demo.
RECORDING_API_KEY=
# Bounded retry/backoff for a recording that is a moment late after hangup.
RECORDING_RETRY_MAX_ATTEMPTS=6
RECORDING_RETRY_DELAY_MS=1500

# --- Speech-to-text (Vietnamese) ----------------------------------
# provider: "google" (Google Cloud Speech-to-Text, default) or "whisper".
STT_PROVIDER=google
# google: leave blank (uses https://speech.googleapis.com). whisper: the base URL.
STT_BASE_URL=
# google: an API key for a project with the Cloud Speech-to-Text API enabled.
STT_API_KEY=
# Which stereo channel is the RM (agent): left|right. Other channel = KH.
# Default left=RM, right=KH. Flip to "right" if the legs are reversed — no code change.
STT_RM_CHANNEL=left

# --- CORS: origins allowed to call this backend from the browser ---
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth mode (U6, ADR-007) -------------------------------------------------
# "demo" (default): a fixed sample RM, no token. "login": real login with a
# Bearer token (POST /api/auth/login). Switching modes is config-only — no code
# change in any other unit.
AUTH_MODE=demo
# Session lifetime in hours (configurable, BR2.1). Login mode only.
AUTH_SESSION_TTL_HOURS=8
# (Optional, BR5.2) fixed delay in ms added to a failed login response to slow
# password guessing. 0 disables it.
AUTH_FAIL_DELAY_MS=0
# Password for the seeded sample RM accounts (rm.a / rm.b) in login mode.
# A CLEARLY-DEMO value only — never a real secret, never committed. Override it
# in your own .env; the code default is the obviously-demo value "demo1234".
AUTH_DEMO_PASSWORD=demo1234

# --- LLM gateway (U2, shared Anthropic Claude client, ADR-004 / I3) -----------
# provider: "anthropic" (real Claude Messages API, default) or "mock"
# (canned, offline — demo/test, no key needed).
LLM_PROVIDER=anthropic
# API key for the Anthropic account. REQUIRED for provider=anthropic.
# Leave blank to run NOT_CONFIGURED (the app still starts; calls return
# NOT_CONFIGURED). NEVER commit a real key.
ANTHROPIC_API_KEY=
# Claude model id, e.g. claude-3-5-sonnet-20241022. Chosen by you when you set a
# key (no hardcoded default in code).
ANTHROPIC_MODEL=
# Provider base URL (must be https for the real provider). Defaults to the
# public Anthropic endpoint; override only for a proxy/mock.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Anthropic Messages API version header.
ANTHROPIC_VERSION=2023-06-01
# Default per-call timeout in ms (30s) and the max-output-tokens ceiling.
LLM_DEFAULT_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS_CAP=4096
